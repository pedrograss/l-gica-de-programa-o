Algoritmo "Conversão de Temperatura"

Var

   celsius: real
   fahrenheit: real



Inicio

    escreval("Digite a temperatura em celsius: ")
    leia(celsius)
    
    fahrenheit <- (celsius * 9 / 5) + 32
    
    escreval("Celsius: ", celsius, "C°")
    escreval("Fahrenheit: ", fahrenheit, "F°")
    
    
    

     
     


Fimalgoritmo