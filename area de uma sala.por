programa
{
	
	funcao inicio()
	{
	real comprimento
	real largura
	real area
	real caixa
	real quantidade
	

	escreva("Digite o comprimento da sala: ")
	leia(comprimento)
	escreva("Digite a largura da sala: ")
	leia(largura)

	area = comprimento * largura
	caixa = 2.5
	quantidade = area / caixa
	

	escreva("Área da sala: ", area, "\n ")
	escreva("Quantidade de caixas de piso necessárias: ", quantidade)

	
	
	
		
	}
}
