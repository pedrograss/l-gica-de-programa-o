Algoritmo "Perimetro do retangulo"


Var

   base: real
   altura: real
   perimetro: real

Inicio

      escreval("Digite a base do retângulo: ")
      leia(base)
      escreval("Digite a altura do retângulo: ")
      leia(altura)
      
      perimetro <- (base + altura) * 2
      escreva("O perímetro do retângulo é: ", perimetro)


     
     
     




Fimalgoritmo