Algoritmo "Segundos para minutos"

Var

   segundos: real
   minutos: real
   segundosDois: real



Inicio


    escreval("Coloque a quantidade de segundos: ")
    leia(segundos)
    
    minutos <- (segundos / 60)
    segundosDois <- (segundos % 60)
    
    escreval(minutos, " minutos", segundosDois, " segundos.")
    
    
    

     
     


Fimalgoritmo