Algoritmo "divisão"

Var

    numero: real
    numeroDois: real
    resultado: real
Inicio

      escreval("Digite um número: ")
      leia(numero)
      escreval("Digite outro número: ")
      leia(numeroDois)
      
      resultado <- numero / numeroDois
      escreva(resultado)
     

     
     
     
     




Fimalgoritmo