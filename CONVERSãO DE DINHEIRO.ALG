Algoritmo "Conversão de dinheiro"

Var

  reais: real
  dolares: real
  resultado: real



Inicio

    escreval("Digite um valor em reais: ")
    leia(reais)
    escreval("Digite a cotação do dólar: ")
    leia(dolares)
    
    resultado <- (reais * dolares)
    escreval("Valor convertido: ", resultado)

    
    
    

     
     


Fimalgoritmo