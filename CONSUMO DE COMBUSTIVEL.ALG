Algoritmo "Consumo de combustivel"

Var

   km: real
   l: real
   consumo: real



Inicio

   escreval("Digite os km percorridos: ")
   leia(km)
   escreval("Digite a quantidade de litros utilizados: ")
   leia(l)
   
   consumo <- (km/l)
   escreva("Consumo médio: ", consumo)
   
    
    
    

     
     


Fimalgoritmo