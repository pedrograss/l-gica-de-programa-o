programa {
  funcao inicio() {

    inteiro idade
    inteiro resultado
    inteiro anos

    escreva("Digite sua idade para saber quantos anos terá daqui a 10 anos: ")
    leia(idade)

    anos = 10

    resultado = (idade + anos)
    escreva("Idade atual: ", idade, "\n ")
    escreva("Idade daqui a 10 anos: ", resultado)


    
  }
}
