Algoritmo "Idade em meses"

Var

  idade: inteiro
  resultado: inteiro

Inicio

      escreval("Saiba quantos meses você já viveu:")
      escreval("Digite sua idade: ")
      leia(idade)
      
      resultado <- (idade * 12)
      escreva("Você viveu ", resultado, " meses.")


Fimalgoritmo