Algoritmo "Area do retangulo"


Var

   base: inteiro
   altura: inteiro
   area: inteiro

Inicio

      escreval("Digite a base do retângulo: ")
      leia(base)
      escreval("Digite a altura do retângulo: ")
      leia(altura)
      
      area <- base * altura
      
      escreva("A área do retângulo é: ", area)


     
     
     




Fimalgoritmo