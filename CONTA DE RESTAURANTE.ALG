Algoritmo "conta de restaurante"

Var

   valorConta: real
   taxa: real
   resultado: real



Inicio

      taxa <- 10.0
     escreval("valor da conta: ")
     leia(valorConta)
     
     resultado <- (valorConta + taxa)
     escreval("Total: ", resultado)
     

    
    
    

     
     


Fimalgoritmo