Algoritmo "Soma"

Var

    numero: inteiro
    numeroDois: inteiro
    resultado: inteiro
Inicio

      escreval("Digite um número: ")
      leia(numero)
      escreval("Digite outro número: ")
      leia(numeroDois)
      
      resultado <- numero + numeroDois
      escreva(resultado)
     

     
     
     
     




Fimalgoritmo